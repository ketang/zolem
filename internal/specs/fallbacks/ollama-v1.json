{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["model", "messages"],
  "properties": {
    "model": {"type": "string"},
    "messages": {"type": "array"},
    "stream": {"type": "boolean"},
    "tools": {"type": "array"},
    "format": {"anyOf": [{"type": "string"}, {"type": "object"}]},
    "options": {"type": "object"},
    "keep_alive": {"anyOf": [{"type": "string"}, {"type": "number"}]},
    "think": {"anyOf": [{"type": "boolean"}, {"type": "string"}]},
    "truncate": {"type": "boolean"},
    "shift": {"type": "boolean"}
  },
  "additionalProperties": true
}
