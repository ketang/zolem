{
  "resources": {
    "models": {
      "methods": {
        "generateContent": {
          "id": "models.generateContent",
          "request": {
            "$ref": "GenerateContentRequest"
          }
        },
        "streamGenerateContent": {
          "id": "models.streamGenerateContent",
          "request": {
            "$ref": "GenerateContentRequest"
          }
        }
      }
    }
  },
  "schemas": {
    "GenerateContentRequest": {
      "type": "object",
      "required": [
        "contents"
      ],
      "properties": {
        "contents": {
          "type": "array",
          "items": {
            "$ref": "Content"
          }
        },
        "generationConfig": {
          "$ref": "GenerationConfig"
        }
      }
    },
    "Content": {
      "type": "object",
      "required": [
        "parts"
      ],
      "properties": {
        "role": {
          "type": "string"
        },
        "parts": {
          "type": "array",
          "items": {
            "$ref": "Part"
          }
        }
      }
    },
    "Part": {
      "type": "object",
      "oneOf": [
        {
          "required": [
            "text"
          ]
        },
        {
          "required": [
            "functionCall"
          ]
        },
        {
          "required": [
            "inlineData"
          ]
        },
        {
          "required": [
            "functionResponse"
          ]
        },
        {
          "required": [
            "fileData"
          ]
        },
        {
          "required": [
            "executableCode"
          ]
        },
        {
          "required": [
            "codeExecutionResult"
          ]
        },
        {
          "required": [
            "thoughtSignature"
          ],
          "not": {
            "oneOf": [
              {
                "required": [
                  "text"
                ]
              },
              {
                "required": [
                  "functionCall"
                ]
              },
              {
                "required": [
                  "inlineData"
                ]
              },
              {
                "required": [
                  "functionResponse"
                ]
              },
              {
                "required": [
                  "fileData"
                ]
              },
              {
                "required": [
                  "executableCode"
                ]
              },
              {
                "required": [
                  "codeExecutionResult"
                ]
              }
            ]
          }
        }
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "functionCall": {
          "$ref": "FunctionCall"
        },
        "inlineData": {
          "$ref": "Blob"
        },
        "functionResponse": {
          "$ref": "FunctionResponse"
        },
        "fileData": {
          "$ref": "FileData"
        },
        "executableCode": {
          "$ref": "ExecutableCode"
        },
        "codeExecutionResult": {
          "$ref": "CodeExecutionResult"
        },
        "thought": {
          "type": "boolean"
        },
        "thoughtSignature": {
          "type": "string"
        },
        "videoMetadata": {
          "type": "object"
        }
      }
    },
    "FunctionCall": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "args": {
          "type": "object"
        }
      }
    },
    "Blob": {
      "type": "object",
      "required": [
        "mimeType",
        "data"
      ],
      "properties": {
        "mimeType": {
          "type": "string"
        },
        "data": {
          "type": "string"
        }
      }
    },
    "GenerationConfig": {
      "type": "object",
      "properties": {
        "maxOutputTokens": {
          "type": "integer"
        }
      }
    },
    "FunctionResponse": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "response": {
          "type": "object"
        }
      }
    },
    "FileData": {
      "type": "object",
      "required": [
        "fileUri"
      ],
      "properties": {
        "fileUri": {
          "type": "string"
        },
        "mimeType": {
          "type": "string"
        }
      }
    },
    "ExecutableCode": {
      "type": "object",
      "required": [
        "language",
        "code"
      ],
      "properties": {
        "language": {
          "type": "string"
        },
        "code": {
          "type": "string"
        }
      }
    },
    "CodeExecutionResult": {
      "type": "object",
      "required": [
        "outcome"
      ],
      "properties": {
        "outcome": {
          "type": "string"
        },
        "output": {
          "type": "string"
        }
      }
    }
  }
}
